[Unit]
Description=Pocket Trails — hikes and rides
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-trails
Group=pocket-trails
ExecStart=/usr/local/bin/pocket-trails
Environment=DATA_DIR=/var/lib/pocket-trails
Environment=PORT=8080
Environment=BASE_URL=https://trails.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-trails
PrivateTmp=true

[Install]
WantedBy=multi-user.target
