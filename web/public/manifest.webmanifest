{
  "name": "Pocket Trails",
  "short_name": "Trails",
  "description": "Plan hikes and bike rides: routes on a map with the climb, water and huts along the way, what to pack, the weather on the day, a time to be back by, and how it went. Linked to your other Pocket apps.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#2e6b4a",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/" },
    { "name": "Routes", "url": "/routes" },
    { "name": "Plan an outing", "url": "/?add=outing" }
  ]
}
